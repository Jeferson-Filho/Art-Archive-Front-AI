{
  "info": {
    "name": "Art Archive AI — Backend",
    "description": "Executable version of the API contract in documentation/specs/07-api-contract.md. Every request carries tests asserting status code and body shape, so running the whole collection (Postman Runner or `newman run`) checks the contract end to end.\n\nThe source of truth stays doc 07 — when the contract changes, update doc 07 first, then this collection.\n\nNot covered here: `502 HARVARD_API_ERROR` on /artworks/*, which needs Harvard to fail and is covered by backend/tests/test_insight_card_endpoints.py instead.\n\nSince doc 07 v2.4 each Insight Card block has a GET that only reads (null when missing) and a POST that generates from an image the front-end sends. The collection never sends a real image, so it never triggers generation or consumes Azure OpenAI tokens: the POSTs here only check validation (400) and the existence check (404). Generation with a real image is covered by the front-end flow and, with a fake pipeline, by backend/tests/test_insight_card_endpoints.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "existingArtworkId", "value": "299843" },
    { "key": "missingArtworkId", "value": "999999999" },
    { "key": "personId", "value": "22730" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Harvard Proxy (doc 07 §3)",
      "description": "Forwards to the Harvard Art Museums API with the key attached server-side. These are the calls the front-end makes today.",
      "item": [
        {
          "name": "Object detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/proxy/object/{{existingArtworkId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the artwork record\", () => {",
                  "    pm.expect(pm.response.json().objectid).to.eql(Number(pm.variables.get(\"existingArtworkId\")));",
                  "});",
                  "pm.test(\"API key never in the response (RNF-005)\", () => {",
                  "    pm.expect(pm.response.text()).to.not.include(\"apikey\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Object people",
          "request": { "method": "GET", "url": "{{baseUrl}}/proxy/object/{{existingArtworkId}}/people" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"list of people\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Person",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/proxy/person/?id={{personId}}",
              "host": ["{{baseUrl}}"],
              "path": ["proxy", "person", ""],
              "query": [{ "key": "id", "value": "{{personId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"one record\", () => pm.expect(pm.response.json().records).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Grid query",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/proxy/object?size=5&hasimage=1",
              "host": ["{{baseUrl}}"],
              "path": ["proxy", "object"],
              "query": [
                { "key": "size", "value": "5" },
                { "key": "hasimage", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"info.next and info.prev stripped\", () => {",
                  "    const info = pm.response.json().info;",
                  "    pm.expect(info).to.not.have.property(\"next\");",
                  "    pm.expect(info).to.not.have.property(\"prev\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Insight Card (doc 07 §4)",
      "description": "One independent endpoint per block. The front-end fires both in parallel and recombines them (doc 06 §5). An empty text is a normal outcome, not an error.",
      "item": [
        {
          "name": "Historical context — read",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/artworks/{{existingArtworkId}}/historical-context"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"fields exactly as doc 07 §4\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(Object.keys(body).sort()).to.eql([\"artwork_id\", \"historical_context\", \"historical_context_sources\"]);",
                  "    pm.expect(body.artwork_id).to.eql(Number(pm.variables.get(\"existingArtworkId\")));",
                  "    pm.expect(body.historical_context === null || typeof body.historical_context === \"string\").to.be.true;",
                  "    pm.expect(body.historical_context_sources).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"null when missing, never empty when persisted (doc 07 §4)\", () => {",
                  "    const body = pm.response.json();",
                  "    if (body.historical_context === null) pm.expect(body.historical_context_sources).to.be.empty;",
                  "    else pm.expect(body.historical_context).to.not.eql(\"\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Historical context — read, non-integer id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/artworks/abc/historical-context"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"envelope with VALIDATION_ERROR\", () => {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(error.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Historical context — generate, invalid image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"image\": \"https://nrs.harvard.edu/not-a-data-url\"}"
            },
            "url": "{{baseUrl}}/artworks/{{existingArtworkId}}/historical-context"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"envelope with VALIDATION_ERROR\", () => {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(error.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Historical context — generate, nonexistent artwork",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"image\": \"data:image/jpeg;base64,/9j/4AAQ\"}"
            },
            "url": "{{baseUrl}}/artworks/{{missingArtworkId}}/historical-context"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"envelope with ARTWORK_NOT_FOUND\", () => {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error.code).to.eql(\"ARTWORK_NOT_FOUND\");",
                  "    pm.expect(error.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Comparative analysis — read",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/artworks/{{existingArtworkId}}/comparative-analysis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"fields exactly as doc 07 §4\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(Object.keys(body).sort()).to.eql([\"artwork_id\", \"comparative_analysis\", \"comparative_analysis_sources\"]);",
                  "    pm.expect(body.artwork_id).to.eql(Number(pm.variables.get(\"existingArtworkId\")));",
                  "    pm.expect(body.comparative_analysis === null || typeof body.comparative_analysis === \"string\").to.be.true;",
                  "    pm.expect(body.comparative_analysis_sources).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"null when missing, never empty when persisted (doc 07 §4)\", () => {",
                  "    const body = pm.response.json();",
                  "    if (body.comparative_analysis === null) pm.expect(body.comparative_analysis_sources).to.be.empty;",
                  "    else pm.expect(body.comparative_analysis).to.not.eql(\"\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Comparative analysis — read, non-integer id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/artworks/abc/comparative-analysis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"envelope with VALIDATION_ERROR\", () => {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(error.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Comparative analysis — generate, invalid image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"image\": \"https://nrs.harvard.edu/not-a-data-url\"}"
            },
            "url": "{{baseUrl}}/artworks/{{existingArtworkId}}/comparative-analysis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"envelope with VALIDATION_ERROR\", () => {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(error.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Comparative analysis — generate, nonexistent artwork",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"image\": \"data:image/jpeg;base64,/9j/4AAQ\"}"
            },
            "url": "{{baseUrl}}/artworks/{{missingArtworkId}}/comparative-analysis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"envelope with ARTWORK_NOT_FOUND\", () => {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error.code).to.eql(\"ARTWORK_NOT_FOUND\");",
                  "    pm.expect(error.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error envelope (doc 07 §1)",
      "description": "Errors raised by the framework itself also leave in the standard envelope.",
      "item": [
        {
          "name": "Unknown route",
          "request": { "method": "GET", "url": "{{baseUrl}}/does-not-exist" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"envelope with NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong method",
          "request": { "method": "PUT", "url": "{{baseUrl}}/artworks/{{existingArtworkId}}/historical-context" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"envelope with METHOD_NOT_ALLOWED\", () => pm.expect(pm.response.json().error.code).to.eql(\"METHOD_NOT_ALLOWED\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
